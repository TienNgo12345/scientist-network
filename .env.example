# Chép file này thành .env rồi chọn MỘT nhà cung cấp mô hình ngôn ngữ (≤ 9 tỷ tham số)

# 1) Ollama chạy trên máy (khuyên dùng):  cài https://ollama.com  rồi  `ollama pull qwen2.5:7b`
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# 2) OpenRouter (API, trả phí rất rẻ / có model free):
# LLM_PROVIDER=openrouter
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# OPENROUTER_API_KEY=...

# 3) Không dùng LLM (bộ lập kế hoạch theo luật):
# LLM_PROVIDER=none
